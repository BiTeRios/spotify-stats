APP_NAME=Spotify Stats API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

FRONTEND_URL=http://127.0.0.1:5173

SPOTIFY_CLIENT_ID=your_real_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_real_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

SPOTIFY_REQUEST_TIMEOUT_SECONDS=10
SPOTIFY_ACCESS_TOKEN_REFRESH_LEEWAY_SECONDS=60
SPOTIFY_REFRESH_TOKEN_LIFETIME_DAYS=180

OAUTH_STATE_COOKIE_NAME=spotify_oauth_state
OAUTH_STATE_COOKIE_MAX_AGE=600

COOKIE_SECURE=false

DATABASE_URL=sqlite+aiosqlite:///./spotify_stats.db

SESSION_COOKIE_NAME=spotify_stats_session
SESSION_COOKIE_MAX_AGE=2592000